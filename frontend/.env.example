# Frontend Configuration
# All variables must be prefixed with VITE_ to be accessible in the browser

# Backend API URL (when NOT using Vite proxy)
# Leave empty to use proxy (recommended for development)
VITE_API_URL=

# Socket.io Server URL
VITE_SOCKET_URL=http://localhost:3001

# App Name
VITE_APP_NAME=VoIP Suite

# Environment
VITE_ENVIRONMENT=development

# Enable debug mode
VITE_DEBUG=true
