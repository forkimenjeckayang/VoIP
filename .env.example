# Database Configuration
DB = 'mongodb://user:pass@127.0.0.1:27017/voipsuite?authSource=admin'

# Server Configuration
NODE_ENV = development
PORT = 3001
HOST = localhost
BASE_URL = 'http://localhost:3001'
HTTPS = false

# Security Keys (JWT & Session)
# Generate random strings for these
COOKIE_KEY = change_me_to_a_random_string_1
COOKIE_KEY2 = change_me_to_a_random_string_2

# Twilio Master Account Credentials (REQUIRED)
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID = ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN = yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# SaaS Configuration
# Maximum phone numbers a user can claim (default: 2)
MAX_NUMBERS_PER_USER = 2

# Allowed countries for phone number inventory (comma-separated, default: US)
# Examples: 'US', 'US,CA', 'US,CA,GB'
ALLOWED_COUNTRIES = US

# Application Settings
SIGNUPS = on
APPDIRECTORY = 'voip'

# Node.js Options
NODE_OPTIONS = --max_old_space_size=460
